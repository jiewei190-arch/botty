# ============================================================================
# Algorithmic trading bot — environment configuration
#
# Copy this file to `.env` and fill in your credentials:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real API keys.
# ============================================================================

# ----------------------------------------------------------------------------
# TRADING MODE
# ----------------------------------------------------------------------------
# backtest : historical simulation only, no broker connection
# paper    : Alpaca paper account (DEFAULT — no real money)
# live     : real money. Requires BOTH locks below.
TRADING_MODE=paper

# --- Live trading double lock -----------------------------------------------
# Setting TRADING_MODE=live is NOT enough. Both of these must also be set, or
# the bot refuses to start. This is deliberate: it makes real-money trading
# impossible to enable by accident or by typo.
ENABLE_LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=

# ----------------------------------------------------------------------------
# ALPACA CREDENTIALS
# ----------------------------------------------------------------------------
# Get free paper-trading keys at https://app.alpaca.markets/paper/dashboard/overview
# Paper and live accounts have SEPARATE key pairs.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Market data feed:
#   iex  - free tier, IEX exchange only (default)
#   sip  - full consolidated tape, requires a paid Alpaca data subscription
ALPACA_DATA_FEED=iex

# Corporate-action adjustment for historical bars:
#   all  - split + dividend adjusted (default; avoids fake gaps in backtests)
#   raw | split | dividend
ALPACA_ADJUSTMENT=all

ALPACA_MAX_RETRIES=4
ALPACA_RETRY_BASE_DELAY_SECONDS=1.0

# ----------------------------------------------------------------------------
# MARKET DATA / WATCHLIST
# ----------------------------------------------------------------------------
DATA_WATCHLIST=AAPL,NVDA,TSLA,AMD,MSFT,META,AMZN,GOOGL,SPY,QQQ

# Bar size used for analysis: 1Min, 5Min, 15Min, 30Min, 1Hour, 4Hour, 1Day, 1Week
DATA_TIMEFRAME=15Min

# Bars of history pulled per symbol (indicator warm-up needs headroom)
DATA_LOOKBACK_BARS=300

# Cache downloaded bars as parquet so backtests do not re-download every run
DATA_CACHE_ENABLED=true

# ----------------------------------------------------------------------------
# RISK MANAGEMENT
# ----------------------------------------------------------------------------
# The balance every position size is calculated from. Set this to the account
# you actually trade in.
#
# This is stated here rather than read from a broker on purpose: the place you
# get data from and the place you trade need not be the same. If you scan with
# an Alpaca data-only key and trade on Robinhood, the Alpaca account holds
# nothing, and sizing against it would return share counts unrelated to the
# money genuinely at risk.
RISK_ACCOUNT_EQUITY=10000

# Percentage of account equity risked per trade (distance from entry to stop).
# 1.0 on a $10,000 account = $100 maximum loss per trade.
RISK_MAX_RISK_PER_TRADE_PCT=1.0

# Trading halts for the day once losses reach this percentage of equity.
RISK_MAX_DAILY_LOSS_PCT=3.0

# Hard caps on concurrent exposure.
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_PORTFOLIO_EXPOSURE_PCT=60.0
RISK_MAX_POSITION_SIZE_PCT=20.0

# Signals with a worse reward:risk ratio than this are rejected outright.
RISK_MIN_RISK_REWARD=2.0

# Fallback exit distances when a strategy does not supply its own.
RISK_DEFAULT_STOP_LOSS_PCT=2.0
RISK_DEFAULT_TAKE_PROFIT_PCT=5.0

# After this many consecutive losses, pause trading for the cooldown period.
RISK_CONSECUTIVE_LOSS_LIMIT=3
RISK_COOLDOWN_MINUTES=60

# Minimum scanner confidence (0-100) required to trade a signal.
RISK_MIN_CONFIDENCE=60.0

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON_ENABLED=true
