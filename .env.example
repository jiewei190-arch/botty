# ============================================================================
# Algorithmic swing-trading bot — environment configuration
#
# Copy this file to `.env` and fill in your credentials:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real API keys.
# ============================================================================

# ----------------------------------------------------------------------------
# TRADING MODE
# ----------------------------------------------------------------------------
# backtest : historical simulation only, no broker connection
# paper    : Alpaca paper account (DEFAULT — no real money)
# live     : real money. Requires BOTH locks below.
TRADING_MODE=paper

# --- Live trading double lock -----------------------------------------------
ENABLE_LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=

# ----------------------------------------------------------------------------
# ALPACA CREDENTIALS
# ----------------------------------------------------------------------------
# Get free paper-trading keys from your Alpaca paper dashboard.
# Paper and live accounts have SEPARATE key pairs.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Market data feed:
#   iex  - free tier, IEX exchange only (default)
#   sip  - full consolidated tape, requires a paid Alpaca data subscription
ALPACA_DATA_FEED=iex

# Corporate-action adjustment for historical bars:
#   all  - split + dividend adjusted (default; avoids fake gaps in backtests)
#   raw | split | dividend
ALPACA_ADJUSTMENT=all
ALPACA_MAX_RETRIES=4
ALPACA_RETRY_BASE_DELAY_SECONDS=1.0

# ----------------------------------------------------------------------------
# MARKET DATA / WATCHLIST
# ----------------------------------------------------------------------------
DATA_WATCHLIST=AAPL,NVDA,TSLA,AMD,MSFT,META,AMZN,GOOGL,SPY,QQQ

# Botty is a SWING bot. Daily bars are the default context; intraday bars may
# later be used only for entry timing, not to turn this into a day-trading bot.
DATA_TIMEFRAME=1Day

# 500 daily bars gives ~2 years of context and enough history for the 200 EMA.
DATA_LOOKBACK_BARS=500
DATA_CACHE_ENABLED=true

# ----------------------------------------------------------------------------
# RISK MANAGEMENT
# ----------------------------------------------------------------------------
RISK_ACCOUNT_EQUITY=10000
RISK_MAX_RISK_PER_TRADE_PCT=1.0
RISK_MAX_DAILY_LOSS_PCT=3.0
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_PORTFOLIO_EXPOSURE_PCT=60.0
RISK_MAX_POSITION_SIZE_PCT=20.0
RISK_MIN_RISK_REWARD=2.0
RISK_DEFAULT_STOP_LOSS_PCT=2.0
RISK_DEFAULT_TAKE_PROFIT_PCT=5.0
RISK_CONSECUTIVE_LOSS_LIMIT=3
RISK_COOLDOWN_MINUTES=60

# High-quality swing filter. This is deliberately stricter than the old default.
RISK_MIN_CONFIDENCE=70.0

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON_ENABLED=true

# ----------------------------------------------------------------------------
# MARKET SCANNER (Phase 1)
# ----------------------------------------------------------------------------
# Symbol categories to watch. See `python main.py universe` for the full list:
# MEGA_CAPS, TECH, SEMICONDUCTORS, FINANCIALS, ENERGY, INDEX_ETFS, SECTOR_ETFS
#
# NOTE: Alpaca's free plan caps a websocket subscription at 30 SYMBOLS. The
# default below resolves to 27, leaving room for a few of your own. Going over
# is not fatal — the scanner refuses to stream and tells you to trim the list
# or use `python main.py scan` (REST), where the cap does not apply.
SCANNER_CATEGORIES=INDEX_ETFS,MEGA_CAPS
SCANNER_EXTRA_SYMBOLS=
SCANNER_EXCLUDE_SYMBOLS=

# Optional JSON file of your own categories. A category in the file REPLACES the
# built-in of the same name; an empty list removes it.
#   { "MY_LIST": ["AAPL", "NVDA"], "ENERGY": [] }
SCANNER_UNIVERSE_FILE=

# Bar size the detectors analyse. Alpaca streams MINUTE bars; anything coarser
# is aggregated locally and published only once the bar is complete.
SCANNER_TIMEFRAME=5Min
SCANNER_LOOKBACK_BARS=400
SCANNER_MAX_BARS=1500

# Streaming. With this off (or `watch --no-stream`) the scanner polls REST.
SCANNER_STREAM_ENABLED=true
SCANNER_STREAM_BARS=true
SCANNER_STREAM_TRADES=false
# Quotes arrive per tick — thousands of messages a second for 30 symbols — and
# the detectors read bars. Leave this off unless you are building on the raw feed.
SCANNER_STREAM_QUOTES=false

# Seconds between REST cycles. 0 tracks SCANNER_TIMEFRAME automatically.
SCANNER_POLL_SECONDS=0
# Seconds of websocket silence before a health warning is logged. Advisory:
# overnight silence is correct, not a fault.
SCANNER_STREAM_STALENESS_SECONDS=300

# Analyse only during 09:30-16:00 ET. Off by default so pre-market and
# after-hours moves are still reported — that is when swing entries get planned.
SCANNER_REGULAR_HOURS_ONLY=false

# Scoring weights. Renormalised, so only their relative size matters.
SCANNER_WEIGHT_VOLUME=0.25
SCANNER_WEIGHT_MOMENTUM=0.25
SCANNER_WEIGHT_BREAKOUT=0.25
SCANNER_WEIGHT_GAP=0.15
SCANNER_WEIGHT_VOLATILITY=0.10

# ----------------------------------------------------------------------------
# DETECTOR THRESHOLDS
# ----------------------------------------------------------------------------
# The five worth tuning. The rest live in trading_bot/detectors/base.py, where
# every default is stated next to the reasoning behind it.

# Relative volume at which participation stops being ordinary (1.5 = 150% of
# the symbol's own norm for this time of day).
DETECTOR_VOLUME_THRESHOLD=1.5

# Move size in ATR units that counts as momentum. ATR rather than percent, so
# one setting works for a $9 stock and a $900 one.
DETECTOR_MOMENTUM_ATR_THRESHOLD=1.5

# How far past a level a close must land before the break counts, in percent.
# Without a buffer every tick through a level reads as a breakout.
DETECTOR_BREAKOUT_BUFFER_PCT=0.05

# Percentage gap from the previous close that counts as a gap.
DETECTOR_GAP_THRESHOLD_PCT=1.0

# Bar-range expansion ratio (recent ranges vs the symbol's own baseline).
DETECTOR_VOLATILITY_THRESHOLD=1.6

# ----------------------------------------------------------------------------
# ALERTS
# ----------------------------------------------------------------------------
# Overall score (0-10) required before the scanner interrupts you. With the
# default weights, 5.0 needs real confluence: roughly two strong detectors
# agreeing, or three moderate ones.
ALERT_MIN_SCORE=5.0

# Silence for one symbol and direction after an alert. Without this, a symbol in
# a strong trend alerts every bar for an hour.
ALERT_COOLDOWN_SECONDS=900

# Score improvement that re-opens the cooldown early. A setup that was a 5.2 an
# hour ago and is now an 8.9 has genuinely changed.
ALERT_ESCALATION_DELTA=1.5

# Hard cap per symbol per trading day, escalations included.
ALERT_MAX_PER_SYMBOL_PER_SESSION=5

# Minimum directional agreement (0-1) among a symbol's signals. 0 disables it.
ALERT_MIN_AGREEMENT=0.0

# Suppress alerts whose signals cancel out to no direction.
ALERT_REQUIRE_DIRECTION=true

ALERT_CONSOLE_ENABLED=true
ALERT_LOG_ENABLED=true
ALERT_DATABASE_ENABLED=true

# ----------------------------------------------------------------------------
# AUTOMATION / NOTIFICATIONS
# ----------------------------------------------------------------------------
AUTO_CLOSED_POLL_SECONDS=300
AUTO_OPEN_POLL_SECONDS=60
AUTO_MAX_SIGNAL_AGE_HOURS=120
AUTO_MAX_ORDER_FAILURES_PER_SCAN=2
AUTO_WEBHOOK_KIND=slack
AUTO_WEBHOOK_URL=
AUTO_WEBHOOK_TIMEOUT_SECONDS=10
# Interactive Slack status checks (both are required when enabled)
AUTO_SLACK_BOT_TOKEN=
AUTO_SLACK_APP_TOKEN=

# Strongly recommended whenever the dashboard is reachable from the internet.
# This is a separate password you create; it is not an Alpaca or Slack secret.
DASHBOARD_PASSWORD=

# Swing-options guardrails (paper automation defaults)
OPTIONS_ENABLED=true
# Send exact contract ideas to Slack without submitting a paper order.
OPTIONS_ALERT_ONLY=true
OPTIONS_MIN_DTE=7
OPTIONS_MAX_DTE=60
OPTIONS_EXCEPTIONAL_MAX_DTE=60
OPTIONS_EXCEPTIONAL_MIN_CONFIDENCE=90
OPTIONS_TARGET_DTE=30
OPTIONS_MIN_PREMIUM_PER_TRADE=500
OPTIONS_MAX_PREMIUM_PER_TRADE=1000
OPTIONS_MAX_TOTAL_PREMIUM=2000
OPTIONS_MAX_CONTRACTS_PER_TRADE=4
OPTIONS_MAX_TOTAL_CONTRACTS=4
OPTIONS_MAX_OPEN_POSITIONS=2
OPTIONS_PLANNED_MIN_HOLD_DAYS=7
OPTIONS_PLANNED_MAX_HOLD_DAYS=60
